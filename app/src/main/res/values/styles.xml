<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="App" />
    <style name="App.Text" />

    <style name="App.Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App.Text.Subtitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App.Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="App.Text.Small">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="App.Text.Price">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/accent_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App.Chip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">@dimen/spacing_medium</item>
        <item name="android:paddingEnd">@dimen/spacing_medium</item>
        <item name="android:paddingTop">@dimen/spacing_small</item>
        <item name="android:paddingBottom">@dimen/spacing_small</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App.ProfileRow">
        <item name="android:padding">@dimen/spacing_medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="App.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="App.ButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="App.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius</item>
    </style>
</resources>