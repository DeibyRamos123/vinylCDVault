<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="@dimen/corner_radius"
    app:strokeColor="@color/input_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:layout_width="@dimen/avatar_small"
            android:layout_height="@dimen/avatar_small"
            android:background="@drawable/bg_logo_circle"
            android:gravity="center"
            android:text="👤"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserName"
                style="@style/App.Text.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvUserEmail"
                style="@style/App.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUserRole"
                    style="@style/App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvUserStatus"
                    style="@style/App.Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnEditUser"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_edit_user"
            android:padding="12dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/primary" />

        <ImageView
            android:id="@+id/btnDeleteUser"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_delete_user"
            android:padding="12dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/accent" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>